# Enable MPU
CONFIG_ARM_MPU=y

# Enable hardware stack protection
CONFIG_HW_STACK_PROTECTION=y

# Enable GPIO
CONFIG_GPIO=y

# Console is the USB CDC ACM instance (zephyr,console in the DTS). The USB
# device stack itself is enabled by the application, so images that do not
# want a console (MCUboot) simply leave it off.
CONFIG_SERIAL=y
CONFIG_CONSOLE=y
CONFIG_UART_CONSOLE=y
