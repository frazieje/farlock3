# Enable MPU
CONFIG_ARM_MPU=y

# Enable hardware stack protection
CONFIG_HW_STACK_PROTECTION=y

# Enable GPIO
CONFIG_GPIO=y

# Enable uart driver
CONFIG_SERIAL=y

# Enable console
CONFIG_CONSOLE=y
CONFIG_UART_CONSOLE=y
CONFIG_UART_LINE_CTRL=y

# Enable USB
CONFIG_USB_DEVICE_STACK_NEXT=y
CONFIG_USBD_CDC_ACM_CLASS=y

CONFIG_FARLOCK3_USBD_VID=0x1915           
CONFIG_FARLOCK3_USBD_PID=0x0004
CONFIG_FARLOCK3_USBD_MANUFACTURER="frazieje"
CONFIG_FARLOCK3_USBD_PRODUCT="FARLock3"

