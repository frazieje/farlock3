/*
 * FARLock v3 board (hardware revision v02)
 * https://github.com/frazieje/farlock3-hw
 *
 * nRF52840 (Raytac MDBT50Q-U1M), TB6612FNG h-bridge, MX25R6435F QSPI flash,
 * USB micro-B (power + CDC ACM console). No UART pins are broken out.
 *
 * SPDX-License-Identifier: Apache-2.0
 */

/dts-v1/;
#include <nordic/nrf52840_qiaa.dtsi>
#include <nordic/nrf52840_partition.dtsi>
#include "farlock3-pinctrl.dtsi"
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <zephyr/dt-bindings/pwm/pwm.h>

/ {
	model = "FARLock v3";
	compatible = "frazieje,farlock3";

	chosen {
		zephyr,console = &cdc_acm_uart0;
		zephyr,shell-uart = &cdc_acm_uart0;
		zephyr,uart-mcumgr = &cdc_acm_uart0;
		zephyr,ieee802154 = &ieee802154;
		zephyr,boot-mode = &boot_mode0;
		nordic,pm-ext-flash = &mx25r64;
		zephyr,entropy = &rng;
	};

	/*
	 * LED order matters: the NCS Matter board layer uses the first LED as
	 * the connectivity status LED and the second as the application LED.
	 * All LEDs are sunk by the GPIO through a series resistor to 3V3.
	 */
	leds {
		compatible = "gpio-leds";
		led0: led_0 {
			gpios = <&gpio0 14 GPIO_ACTIVE_LOW>;
			label = "Connection LED (J3)";
		};
		led1: led_1 {
			gpios = <&gpio0 15 GPIO_ACTIVE_LOW>;
			label = "Access granted LED (J5)";
		};
		led2: led_2 {
			gpios = <&gpio0 16 GPIO_ACTIVE_LOW>;
			label = "Access denied LED (J5)";
		};
		led3: led_3 {
			gpios = <&gpio0 13 GPIO_ACTIVE_LOW>;
			label = "Debug LED (on-board blue)";
		};
	};

	/*
	 * Only the momentary program button lives here. The bolt position and
	 * direction switches are deliberately NOT in this node: the dk_buttons
	 * library polls every 10 ms for as long as any "button" is held, and a
	 * position switch sits closed for half of its life.
	 */
	buttons {
		compatible = "gpio-keys";
		button0: button_0 {
			/* 10 k external pull-up (R5), also on J6 pin 3 */
			gpios = <&gpio0 12 GPIO_ACTIVE_LOW>;
			label = "Program button";
			zephyr,code = <INPUT_KEY_0>;
		};
	};

	lock_switches: lock-switches {
		compatible = "frazieje,lock-switches";
		/* Bolt position switch, J5 pin 2, 10 k external pull-up (R4) */
		position-gpios = <&gpio0 25 GPIO_ACTIVE_LOW>;
		/* On-board SPDT handedness switch SW1, 10 k external pull-up (R7) */
		direction-gpios = <&gpio0 24 GPIO_ACTIVE_LOW>;
	};

	motor: motor {
		compatible = "frazieje,tb6612-motor";
		pwms = <&pwm0 0 PWM_MSEC(20) PWM_POLARITY_NORMAL>;
		in1-gpios = <&gpio0 29 GPIO_ACTIVE_HIGH>;
		in2-gpios = <&gpio0 30 GPIO_ACTIVE_HIGH>;
		stby-gpios = <&gpio0 31 GPIO_ACTIVE_HIGH>;
	};

	aliases {
		led0 = &led0;
		led1 = &led1;
		led2 = &led2;
		led3 = &led3;
		sw0 = &button0;
		pwm-motor = &motor;
		watchdog0 = &wdt0;
	};
};

&reg0 {
	status = "okay";
};

&reg1 {
	regulator-initial-mode = <NRF5X_REG_MODE_DCDC>;
};

&uicr {
	/* P0.18 is wired to the RESET pin of the SWD header J2 */
	gpio-as-nreset;
};

&gpiote {
	status = "okay";
};

&nfct {
	status = "okay";
};

&gpio0 {
	status = "okay";
	/* XL1/XL2, NFC1/NFC2, QSPI + RESET */
	gpio-reserved-ranges = <0 2>, <9 2>, <17 7>;
	gpio-line-names = "XL1", "XL2", "", "", "", "", "", "",
			  "", "NFC1", "NFC2", "", "BTN_PRG", "LED_DBG",
			  "LED_CXN", "LED_ACCG", "LED_ACCD", "QSPI_CS", "RESET", "QSPI_CLK",
			  "QSPI_IO0", "QSPI_IO1", "QSPI_IO2", "QSPI_IO3", "SW_DIR",
			  "SW_POS", "", "", "MOTOR_PWM", "MOTOR_IN1", "MOTOR_IN2", "MOTOR_STBY";
};

&gpio1 {
	status = "okay";
};

&pwm0 {
	status = "okay";
	pinctrl-0 = <&pwm0_default>;
	pinctrl-1 = <&pwm0_sleep>;
	pinctrl-names = "default", "sleep";
};

&qspi {
	status = "okay";
	pinctrl-0 = <&qspi_default>;
	pinctrl-1 = <&qspi_sleep>;
	pinctrl-names = "default", "sleep";

	mx25r64: mx25r6435f@0 {
		compatible = "nordic,qspi-nor";
		reg = <0>;
		/* MX25R64 supports only pp and pp4io */
		writeoc = "pp4io";
		/* MX25R64 supports all readoc options */
		readoc = "read4io";
		sck-frequency = <8000000>;
		jedec-id = [c2 28 17];
		sfdp-bfp = [
			e5 20 f1 ff  ff ff ff 03  44 eb 08 6b  08 3b 04 bb
			ee ff ff ff  ff ff 00 ff  ff ff 00 ff  0c 20 0f 52
			10 d8 00 ff  23 72 f5 00  82 ed 04 cc  44 83 68 44
			30 b0 30 b0  f7 c4 d5 5c  00 be 29 ff  f0 d0 ff ff
		];
		size = <67108864>;
		has-dpd;
		t-enter-dpd = <10000>;
		t-exit-dpd = <35000>;
	};
};

&ieee802154 {
	status = "okay";
};

zephyr_udc0: &usbd {
	compatible = "nordic,nrf-usbd";
	status = "okay";

	cdc_acm_uart0: cdc_acm_uart0 {
		compatible = "zephyr,cdc-acm-uart";
	};
};

&gpregret1 {
	status = "okay";

	boot_mode0: boot_mode@0 {
		compatible = "zephyr,retention";
		status = "okay";
		reg = <0x0 0x1>;
	};
};

/*
 * Everything below is unused on this board. The SoC dtsi already leaves these
 * disabled, but we state it explicitly so overlays cannot enable them by
 * accident (no pins are routed for them).
 */
&adc {
	status = "disabled";
};
&uart0 {
	status = "disabled";
};
&uart1 {
	status = "disabled";
};
&i2c0 {
	status = "disabled";
};
&i2c1 {
	status = "disabled";
};
&spi0 {
	status = "disabled";
};
&spi1 {
	status = "disabled";
};
&spi2 {
	status = "disabled";
};
&spi3 {
	status = "disabled";
};
