/*
 * nRF52840 DK bench configuration for FARLock v3 firmware.
 *
 * Mirrors the farlock3 board: console on USB CDC ACM, motor driver on the
 * same pins as the real board (P0.28 to P0.31, available on the Arduino
 * header) and the bolt switches on DK buttons 3 and 4 (P0.24 / P0.25). Button
 * 1 is the program button, button 2 toggles the bolt.
 *
 * SPDX-License-Identifier: Apache-2.0
 */

#include <zephyr/dt-bindings/pwm/pwm.h>

/* Buttons 3 and 4 become the lock switches; keep them out of the polled buttons node. */
/ {
	aliases {
		/delete-property/ sw2;
		/delete-property/ sw3;
	};
};
/delete-node/ &button2;
/delete-node/ &button3;

/ {
	chosen {
		nordic,pm-ext-flash = &mx25r64;
		zephyr,console = &cdc_acm_uart0;
		zephyr,shell-uart = &cdc_acm_uart0;
	};

	lock_switches: lock-switches {
		compatible = "frazieje,lock-switches";
		/* DK button 4 */
		position-gpios = <&gpio0 25 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
		/* DK button 3 */
		direction-gpios = <&gpio0 24 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
	};

	motor: motor {
		compatible = "frazieje,tb6612-motor";
		pwms = <&pwm0 0 PWM_MSEC(20) PWM_POLARITY_NORMAL>;
		in1-gpios = <&gpio0 29 GPIO_ACTIVE_HIGH>;
		in2-gpios = <&gpio0 30 GPIO_ACTIVE_HIGH>;
		stby-gpios = <&gpio0 31 GPIO_ACTIVE_HIGH>;
	};

	aliases {
		pwm-motor = &motor;
	};
};

&pinctrl {
	pwm0_motor_default: pwm0_motor_default {
		group1 {
			psels = <NRF_PSEL(PWM_OUT0, 0, 28)>;
		};
	};

	pwm0_motor_sleep: pwm0_motor_sleep {
		group1 {
			psels = <NRF_PSEL(PWM_OUT0, 0, 28)>;
			low-power-enable;
		};
	};
};

&pwm0 {
	status = "okay";
	pinctrl-0 = <&pwm0_motor_default>;
	pinctrl-1 = <&pwm0_motor_sleep>;
	pinctrl-names = "default", "sleep";
};

&zephyr_udc0 {
	cdc_acm_uart0: cdc_acm_uart0 {
		compatible = "zephyr,cdc-acm-uart";
	};
};

/* Disable unused peripherals to reduce power consumption */
&adc {
	status = "disabled";
};

&uart1 {
	status = "disabled";
};

&i2c0 {
	status = "disabled";
};

&i2c1 {
	status = "disabled";
};

&spi1 {
	status = "disabled";
};

&spi3 {
	status = "disabled";
};
